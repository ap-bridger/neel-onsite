generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Greet {
  id Int @id @default(autoincrement())
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String
  vendors  Vendor[]
  accounts Account[]
}

model Vendor {
  id       Int    @id @default(autoincrement())
  name     String
  clientId Int
  client   Client @relation(fields: [clientId], references: [id])
}

model Account {
  id       Int    @id @default(autoincrement())
  name     String
  clientId Int
  client   Client @relation(fields: [clientId], references: [id])
}

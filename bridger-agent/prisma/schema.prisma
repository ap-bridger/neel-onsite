generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Greet {
  id Int @id @default(autoincrement())
}

model Client {
  id         Int        @id @default(autoincrement())
  name       String
  vendors    Vendor[]
  accounts   Account[]
  categories Category[]
}

model Category {
  id                    Int                   @id @default(autoincrement())
  name                  String
  clientId              Int
  client                Client                @relation(fields: [clientId], references: [id])
  transactionCategories TransactionCategory[]

  @@unique([clientId, name])
  @@unique([id, clientId])
}

model Vendor {
  id                   Int           @id @default(autoincrement())
  name                 String
  clientId             Int
  client               Client        @relation(fields: [clientId], references: [id])
  llmTransactions      Transaction[] @relation("TransactionLlmVendor")
  reviewerTransactions Transaction[] @relation("TransactionReviewerVendor")
}

model Account {
  id           Int           @id @default(autoincrement())
  name         String
  clientId     Int
  client       Client        @relation(fields: [clientId], references: [id])
  transactions Transaction[]

  @@unique([id, clientId])
}

// status is one of: "needs_review", "reviewed", "pending", "missing_info"
model Transaction {
  id                    Int                   @id @default(autoincrement())
  clientId              Int
  accountId             Int
  account               Account               @relation(fields: [accountId, clientId], references: [id, clientId])
  date                  DateTime
  totalAmount           Float
  llmCategories         TransactionCategory[] @relation("TransactionLlmCategory")
  reviewerCategories    TransactionCategory[] @relation("TransactionReviewerCategory")
  llmVendorId           Int?
  llmVendor             Vendor?               @relation("TransactionLlmVendor", fields: [llmVendorId], references: [id])
  llmNewVendorName      String?
  status                String
  reviewerVendorId      Int?
  reviewerVendor        Vendor?               @relation("TransactionReviewerVendor", fields: [reviewerVendorId], references: [id])
  updateReason          String?
  reviewerNewVendorName String?
  missingInfoRequest    String?
  confidence            Float

  llmPairTransactionId       Int?
  llmPairTransaction         Transaction? @relation("TransactionLlmPair", fields: [llmPairTransactionId, clientId], references: [id, clientId])
  llmPairForTransaction      Transaction? @relation("TransactionLlmPair")
  reviewerPairTransactionId  Int?
  reviewerPairTransaction    Transaction? @relation("TransactionReviewerPair", fields: [reviewerPairTransactionId, clientId], references: [id, clientId])
  reviewerPairForTransaction Transaction? @relation("TransactionReviewerPair")

  @@unique([id, clientId])
  @@unique([llmPairTransactionId, clientId])
  @@unique([reviewerPairTransactionId, clientId])
}

model TransactionCategory {
  id                    Int          @id @default(autoincrement())
  clientId              Int
  categoryId            Int
  category              Category     @relation(fields: [categoryId, clientId], references: [id, clientId])
  amount                Float
  llmTransactionId      Int?
  llmTransaction        Transaction? @relation("TransactionLlmCategory", fields: [llmTransactionId, clientId], references: [id, clientId], onDelete: Cascade)
  reviewerTransactionId Int?
  reviewerTransaction   Transaction? @relation("TransactionReviewerCategory", fields: [reviewerTransactionId, clientId], references: [id, clientId], onDelete: Cascade)
}
